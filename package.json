{
  "name": "petcare-pet-shop",
  "version": "1.0.0",
  "private": true,
  "description": "PetCare — sistema de gestão para Pet Shop · projeto parcial PTAS3",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail -n API,WEB -c green,cyan \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "start:backend": "npm run start --workspace backend",
    "test:api": "node backend/tests/api.test.mjs",
    "build:frontend": "npm run build --workspace frontend",
    "install:all": "npm install"
  },
  "keywords": [
    "pet-shop",
    "express",
    "react",
    "zod",
    "json"
  ],
  "author": "Marjorie da Silva Santos",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
